"asset_metadata" [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#087F8C" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="14"><B>asset_metadata</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">FK UQ NN</FONT></TD><TD ALIGN="LEFT">asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">width</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">height</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">camera</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">created_date</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">metadata_json</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">TEXT</FONT></TD></TR></TABLE>>];
