IZE="9">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#087F8C" POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
