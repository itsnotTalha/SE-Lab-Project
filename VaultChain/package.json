{
	"name": "vaultchain",
	"private": true,
	"version": "1.0.0",
	"workspaces": [
		"client",
		"server"
	],
	"scripts": {
		"dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace=server\" \"npm run dev --workspace=client\""
	},
	"devDependencies": {
		"concurrently": "^9.2.4"
	},
	"allowScripts": {
		"bcrypt@5.1.1": true,
		"esbuild@0.25.12": true,
		"sqlite3@6.0.1": true,
		"tesseract.js@7.0.0": true
	}
}
