# Optional Gemini OCR for PNG/JPEG documents (Bengali and English).
# Image content is sent to Google when a key is configured.
# Keep the API key server-side; never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest
GEMINI_OCR_TIMEOUT_MS=45000
ENABLE_GEMINI_TESTS=false
